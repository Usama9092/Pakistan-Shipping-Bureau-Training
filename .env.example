# Example environment variables for local development or Render.
# Do not commit real secrets to GitHub.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=psb-hrdm-files
PUBLIC_URL=https://training.psbureau.org

SUPABASE_ANON_KEY=

AUTH_MODE=local
# Use AUTH_MODE=supabase in production when Supabase Auth is configured.

SESSION_IDLE_MINUTES=30

SESSION_MAX_HOURS=12

ARGON2_TIME_COST=3

ARGON2_MEMORY_COST=65536

ARGON2_PARALLELISM=2

MIN_PASSWORD_LENGTH=12

INITIAL_ADMIN_NAME=PSB Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_LOGIN=
INITIAL_ADMIN_PASSWORD=
ENABLE_DEMO_SEED=false
DEMO_PASSWORD=

AUTH_CALLBACK_URL=https://your-domain.example.com/auth/callback
VERIFY_PUBLIC_URL=https://verify.psbureau.org
SLOW_QUERY_MS=750
PAGE_SLOW_MS=1500
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional AI-assisted MCQ generation (OpenAI-compatible chat-completions endpoint).
# Leave unset to use the built-in deterministic source-grounded generator.
PSB_AI_MCQ_ENDPOINT=
PSB_AI_MCQ_API_KEY=
PSB_AI_MCQ_MODEL=
